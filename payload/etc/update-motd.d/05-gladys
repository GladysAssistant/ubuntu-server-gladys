#!/usr/bin/env python3
"""Show the Gladys status at login, in the language chosen in the installer.

pam_motd runs this script as root for SSH and console logins. It prints the
same screen as the tty1 status console with short command timeouts, so a
stuck Docker daemon delays a login by seconds at most.
"""

import sys

sys.path.insert(0, "/usr/lib/gladys-installer")

COMMAND_TIMEOUT = 2

try:
    import common
    import console
    import i18n

    state = console.read_state()
    addresses = common.current_ipv4_addresses(timeout=COMMAND_TIMEOUT)
    # Only the ready screen shows the Gladys container state.
    services = (
        console.service_states(addresses, timeout=COMMAND_TIMEOUT)
        if state.get("phase") == "READY"
        else {}
    )
    screen = console.render_screen(
        state,
        addresses,
        services,
        language=i18n.read_installed_language(),
    )
    print(console.colorize(screen))
    print()
except Exception:
    pass
